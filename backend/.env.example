NODE_ENV=development
PORT=3001

# Frontends permitidos, separados por vírgula.
CORS_ORIGIN=http://localhost:5173

# Gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=change-me-with-at-least-32-characters

DB_HOST=localhost
DB_PORT=3306
DB_USER=secureplay
DB_PASSWORD=change-me
DB_NAME=secureplay
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CA_CERT_BASE64=
DB_SYNCHRONIZE=true

# Prefira REDIS_URL em hospedagem. URLs valkeys:// são convertidas para rediss://.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Com proxy /api no Pages, use lax e deixe COOKIE_DOMAIN vazio (cookie host-only).
# Use none apenas para acesso direto entre sites diferentes; depende da política de cookies do navegador.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

S3_BUCKET_NAME=secureplay-media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Cadastro e confirmação de e-mail. Verifique o domínio remetente na Resend.
RESEND_API_KEY=
EMAIL_FROM=SecurePlay <acesso@seu-dominio.com>
PUBLIC_SITE_URL=http://localhost:5173
#Limite diário de e-mails do cadastro trial. Padrão 80; mantenha abaixo da cota diária do plano da Resend.
EMAIL_PUBLIC_DAILY_LIMIT=
#Limite diário de e-mails de recuperação (reenvio de confirmação e esqueci senha), contado à parte do cadastro. Padrão 80.
EMAIL_RECOVERY_DAILY_LIMIT=
#Cloudflare Turnstile: segredo do widget. Vazio = verificação desligada (local e testes).
TURNSTILE_SECRET_KEY=
#MFA por TOTP (app autenticador) para admin e platform_admin. Texto longo e aleatório de 32 caracteres ou mais (a chave AES-256 é o SHA-256 dele); menos que isso vale como ausente.
#Vazio = MFA desligado e login como antes, EXCETO para quem já ativou o MFA: sem chave válida, o login dessas contas de gestão responde 503 (não entra só com a senha). Trocar a chave invalida os cadastros de MFA e os códigos de recuperação: cada conta precisa de reset manual do MFA. Guarde-a como segredo.
MFA_ENCRYPTION_KEY=

#true = logout encerra todas as sessões da conta (session_version). Use se o Redis não tiver persistência.
LOGOUT_REVOKES_ALL_SESSIONS=

#Proxy da Cloudflare Pages: mesmo valor do segredo PROXY_SHARED_SECRET das Functions.
#Permite contar as tentativas de login pelo IP real de cada usuário.
PROXY_SHARED_SECRET=

#Cabeçalho com o IP real preenchido pela borda (ex.: cf-connecting-ip). Vazio = desligado.
#Use só um cabeçalho que a borda sempre sobrescreve; senão o cliente forja o próprio IP.
CLIENT_IP_HEADER=

#Teto de conexões WebSocket simultâneas por IP (padrão 100, acima de uma turma atrás do mesmo NAT).
WS_MAX_CONNECTIONS_PER_IP=

#Administrador Inicial
INITIAL_ADMIN_NAME=usuario.admin
INITIAL_ADMIN_EMAIL=admin@email.com
INITIAL_ADMIN_PASSWORD=senha.admin