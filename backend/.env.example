NODE_ENV=development
PORT=3001

# Frontends permitidos, separados por vírgula.
CORS_ORIGIN=http://localhost:5173

# Gere um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=change-me-with-at-least-32-characters

DB_HOST=localhost
DB_PORT=3306
DB_USER=secureplay
DB_PASSWORD=change-me
DB_NAME=secureplay
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CA_CERT_BASE64=
DB_SYNCHRONIZE=true

# Prefira REDIS_URL em hospedagem. URLs valkeys:// são convertidas para rediss://.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Com proxy /api no Pages, use lax e deixe COOKIE_DOMAIN vazio (cookie host-only).
# Use none apenas para acesso direto entre sites diferentes; depende da política de cookies do navegador.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

S3_BUCKET_NAME=secureplay-media
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Cadastro e confirmação de e-mail. Verifique o domínio remetente na Resend.
RESEND_API_KEY=
EMAIL_FROM=SecurePlay <acesso@seu-dominio.com>
PUBLIC_SITE_URL=http://localhost:5173

#Administrador Inicial
INITIAL_ADMIN_NAME=usuario.admin
INITIAL_ADMIN_EMAIL=admin@email.com
INITIAL_ADMIN_PASSWORD=senha.admin