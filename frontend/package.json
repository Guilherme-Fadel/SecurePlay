    "dev": "vite"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "clsx": "2.1.1",
    "framer-motion": "^12.24.7",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.11.0",
    "socket.io-client": "^4.8.3",
    "sonner": "2.0.3",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "an-array-of-english-words": "^2.0.0",
    "dictionary-pt": "^4.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.1"
