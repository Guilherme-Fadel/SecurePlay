{
  "name": "secureplay-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "prebuild": "npm run check:assets && npm run typecheck",
    "check:assets": "node scripts/check-assets.cjs",
